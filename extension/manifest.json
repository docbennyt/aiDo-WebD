{
  "manifest_version": 3,
  "name": "WebD by aiDo",
  "version": "0.1.1",
  "version_name": "0.1.1 access candidate",
  "description": "Select a UI element and prepare focused AI edit context.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open WebD"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      }
    }
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
